# ==============================================================================
# Wiring Diagram QC Assistant - Environment Variables
# Copy to .env and configure secrets accordingly. NEVER commit .env to git.
# ==============================================================================

# Environment
ENVIRONMENT=development
PROJECT_NAME="Wiring Diagram QC Assistant"
VERSION=1.0.0
API_V1_STR=/api/v1

# Security & JWT Tokens
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 16 Multi-AZ)
# Local Docker: postgresql+asyncpg://postgres:postgres@postgres:5432/qc_assistant
# Dev SQLite: sqlite+aiosqlite:///./qc_assistant.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/qc_assistant
DB_ECHO=false

# In-Memory Cache & Asynchronous Task Queue (Redis 7)
REDIS_URL=redis://redis:6379/0

# Object Storage (AWS S3 or Local MinIO)
S3_BUCKET_NAME=qc-assistant-documents
S3_REGION=ap-south-1
S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
PRESIGNED_URL_EXPIRE_SECONDS=900

# AI Provider Configuration (openai, anthropic, gemini, mock)
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Email Notifications (Mailpit / AWS SES)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@spandsons.com

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
